/* ============================================= */
/* TOKENS                                         */
/* ============================================= */
:root {
  --paper: #EFEDE6;
  --paper-raised: #F7F5EF;
  --ink: #1B1B1F;
  --ink-soft: #57565C;
  --accent: #2F5233;
  --accent-soft: #DDE5D9;
  --rule: #D8D5CB;

  --font-display: "Fraunces", serif;
  --font-body: "IBM Plex Sans", sans-serif;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

.wrap {
  max-width: 860px;
  margin: 0 auto;
  padding: 0 24px;
}

a { color: inherit; }

/* ============================================= */
/* HEADER                                         */
/* ============================================= */
.site-header {
  position: sticky;
  top: 0;
  background: rgba(239, 237, 230, 0.9);
  backdrop-filter: blur(6px);
  border-bottom: 1px solid var(--rule);
  z-index: 10;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 18px;
  padding-bottom: 18px;
}

.wordmark {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.1rem;
  letter-spacing: 0.02em;
}

.site-header nav a {
  text-decoration: none;
  font-size: 0.92rem;
  color: var(--ink-soft);
  margin-left: 28px;
  transition: color 0.15s ease;
}

.site-header nav a:hover { color: var(--ink); }

/* ============================================= */
/* HERO                                           */
/* ============================================= */
.hero {
  padding: 96px 0 88px;
}

.eyebrow {
  font-size: 0.8rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  margin: 0 0 18px;
  font-weight: 600;
}

.hero h1 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(2.1rem, 5vw, 3.4rem);
  line-height: 1.15;
  margin: 0 0 22px;
  max-width: 14ch;
}

.ink-underline {
  font-style: italic;
  font-weight: 500;
  position: relative;
  white-space: nowrap;
}

.ink-underline::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  height: 8px;
  background: var(--accent-soft);
  z-index: -1;
}

.hero-sub {
  max-width: 46ch;
  color: var(--ink-soft);
  font-size: 1.05rem;
  margin: 0 0 36px;
}

.hero-actions { display: flex; gap: 14px; flex-wrap: wrap; }

.btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 3px;
  text-decoration: none;
  font-size: 0.92rem;
  font-weight: 500;
  transition: transform 0.15s ease, background 0.15s ease;
}

.btn-primary {
  background: var(--ink);
  color: var(--paper);
}

.btn-primary:hover { transform: translateY(-1px); background: var(--accent); }

.btn-ghost {
  border: 1px solid var(--rule);
  color: var(--ink);
}

.btn-ghost:hover { border-color: var(--ink); }

/* ============================================= */
/* SECTIONS (shared)                              */
/* ============================================= */
.section { padding: 72px 0; border-top: 1px solid var(--rule); }

.section-label {
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-soft);
  margin: 0 0 32px;
}

/* ============================================= */
/* PROJECTS                                       */
/* ============================================= */
.project-grid {
  display: grid;
  gap: 28px;
}

.project-card {
  background: var(--paper-raised);
  border: 1px solid var(--rule);
  border-radius: 4px;
  padding: 28px;
  position: relative;
}

.project-number {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 0.9rem;
  color: var(--accent);
  margin-bottom: 10px;
}

.project-card h3 {
  font-family: var(--font-display);
  font-weight: 600;
  font-size: 1.3rem;
  margin: 0 0 10px;
}

.project-card p {
  color: var(--ink-soft);
  margin: 0 0 18px;
  max-width: 52ch;
}

.project-link {
  text-decoration: none;
  font-weight: 500;
  font-size: 0.92rem;
  border-bottom: 1px solid var(--ink);
  padding-bottom: 2px;
}

/* ============================================= */
/* ABOUT                                          */
/* ============================================= */
.about-inner { max-width: 720px; }

.about-text {
  font-size: 1.05rem;
  max-width: 62ch;
  margin: 0 0 28px;
}

.skills-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  list-style: none;
  padding: 0;
  margin: 0;
}

.skills-list li {
  background: var(--accent-soft);
  color: var(--accent);
  padding: 7px 14px;
  border-radius: 999px;
  font-size: 0.85rem;
  font-weight: 500;
}

/* ============================================= */
/* CONTACT                                        */
/* ============================================= */
.section-contact h2 {
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  max-width: 20ch;
  margin: 0 0 26px;
}

.contact-email {
  display: inline-block;
  font-size: 1.1rem;
  font-weight: 500;
  text-decoration: none;
  border-bottom: 1px solid var(--ink);
  padding-bottom: 3px;
  margin-bottom: 28px;
}

.social-links { display: flex; gap: 22px; margin-top: 18px; }

.social-links a {
  text-decoration: none;
  color: var(--ink-soft);
  font-size: 0.92rem;
}

.social-links a:hover { color: var(--ink); }

/* ============================================= */
/* FOOTER                                         */
/* ============================================= */
.site-footer {
  border-top: 1px solid var(--rule);
  padding: 28px 0;
}

.site-footer p {
  margin: 0;
  font-size: 0.85rem;
  color: var(--ink-soft);
}

/* ============================================= */
/* RESPONSIVE                                     */
/* ============================================= */
@media (min-width: 640px) {
  .project-grid { grid-template-columns: repeat(2, 1fr); }
  .project-card:first-child { grid-column: span 2; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
}
